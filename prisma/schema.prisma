
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum ReminderRecurrence {
  ONCE
  DAILY
  WEEKLY
  CUSTOM
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  emailVerified         Boolean                @default(true)
  authVersion           Int                    @default(0)
  createdAt             DateTime               @default(now())

  tasks                 Task[]
  events                Event[]
  reminders             Reminder[]
  notes                 Note[]
  goals                 Goal[]
  conversations         Conversation[]
  studySessions         StudySession[]
  notifications         Notification[]
  preferences           UserPreferences?
  passwordResetToken    PasswordResetToken?
  emailVerificationCode EmailVerificationCode?
}
model Task {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  dueAt       DateTime?
  priority    Priority   @default(MEDIUM)
  category    String?
  status      TaskStatus @default(TODO)
  reminderAt  DateTime?
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
}

model Event {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  reminderAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
}

model Reminder {
  id         String             @id @default(cuid())
  userId     String
  title      String
  remindAt   DateTime
  recurrence ReminderRecurrence @default(ONCE)
  createdAt  DateTime           @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  category  String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  targetDate  DateTime?
  progress    Int       @default(0)
  milestones  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  minutes   Int
  startedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model UserPreferences {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  timezone                 String   @default("Asia/Manila")
  language                 String   @default("en")
  theme                    String   @default("dark")
  personality              String   @default("friendly")
  responseStyle            String   @default("balanced")
  customInstructions       String   @default("")
  startupPage              String   @default("Dashboard")
  notificationPreferences  Json?
  studyTimes               Json?
  storedMemory             Json?
  uiCustomization          Json?

  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}