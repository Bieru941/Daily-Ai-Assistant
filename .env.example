NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,capacitor://localhost,http://localhost
# Set to none for cross-origin mobile sessions; this requires HTTPS.
SESSION_COOKIE_SAME_SITE=lax
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
JWT_SECRET=replace_with_at_least_32_random_characters
ADMIN_EMAILS=

# Optional AI provider configuration (server-side only).
AI_API_KEY=replace_with_your_ai_api_key
AI_API_URL=https://api.example.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Optional SMTP configuration for verification, password reset, and feedback email.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=
